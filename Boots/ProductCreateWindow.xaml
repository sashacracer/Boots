<Window x:Class="Boots.ProductCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый товар"
        Style="{StaticResource Windows}"
        Width="850" Height="730"
        MinWidth="620" MinHeight="450"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Название"/>
                    <TextBox x:Name="ProductNameBox" MaxLength="255" Margin="0,4,0,10"/>

                    <TextBlock Text="Категория и подкатегория"/>
                    <ComboBox x:Name="SubcategoryBox" Margin="0,4,0,10"
                              DisplayMemberPath="Name" SelectedValuePath="SubcategoryId"/>

                    <TextBlock Text="Производитель"/>
                    <ComboBox x:Name="ManufacturerBox" Margin="0,4,0,10"
                              DisplayMemberPath="ManufacturerName" SelectedValuePath="ManufacturerId"/>

                    <TextBlock Text="Цена, ₽"/>
                    <TextBox x:Name="PriceBox" MaxLength="19" Margin="0,4,0,10"/>

                    <TextBlock Text="Описание"/>
                    <TextBox x:Name="DescriptionBox" Height="65" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,4,0,10"/>

                    <TextBlock Text="Состав"/>
                    <TextBox x:Name="CompositionBox" Height="50" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,4,0,10"/>

                    <TextBlock Text="Остатки по размерам"/>
                    <DataGrid x:Name="StockGrid" Height="150" Margin="0,4,0,0"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" HeadersVisibility="Column"
                              FontFamily="Times New Roman" FontSize="16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Размер" Binding="{Binding SizeValue}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Пар в наличии" Binding="{Binding Quantity}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Фотография"/>
                    <Border Height="170" Margin="0,4,0,10" Padding="8" BorderBrush="#70B2AF" BorderThickness="1">
                        <Image x:Name="PhotoPreview" Stretch="Uniform"/>
                    </Border>
                    <Button Content="Выбрать фото" Click="ChoosePhoto_Click" Padding="12,4"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сохранить" Click="SaveProduct_Click" Padding="16,4" Margin="0,0,10,0"/>
            <Button Content="Отмена" IsCancel="True" Padding="16,4"/>
        </StackPanel>
    </Grid>
</Window>
