<Window x:Class="Boots.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Style="{StaticResource Windows}"
        Title="Каталог товаров" Height="800" Width="1200">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="ProductDetailsVisibility"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Каталог товаров"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <TextBlock Name="FullUserName"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"/>

            <StackPanel x:Name="ProductFilters"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Margin="0,12,0,0"
                        Visibility="Collapsed">
                <TextBlock Text="Поиск"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox x:Name="SearchBox"
                         Width="260"
                         Margin="0,0,16,0"/>

                <ComboBox x:Name="PriceSort" Width="230" SelectedIndex="0">
                    <ComboBoxItem Content="По названию"/>
                    <ComboBoxItem Content="Сначала дешевле"/>
                    <ComboBoxItem Content="Сначала дороже"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="ProductList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,8,10"
                                Padding="15"
                                BorderBrush="#70B2AF"
                                BorderThickness="1"
                                MouseLeftButtonUp="ProductCard_MouseLeftButtonUp">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanOpenProduct, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasLowStock}" Value="True">
                                            <Setter Property="Background" Value="#FADBD8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Image Source="{Binding ImagePath}"
                                       Width="100"
                                       Height="100"
                                       Stretch="Uniform"/>

                                <StackPanel Grid.Column="1" Margin="16,0">
                                    <TextBlock Text="{Binding ProductName}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding Category}"
                                               FontSize="16"
                                               Foreground="#385D5B"
                                               Margin="0,2,0,0"/>

                                    <TextBlock Text="{Binding Description}"
                                               FontSize="16"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"/>

                                    <TextBlock Text="{Binding ManufacturerName, StringFormat='Производитель: {0}'}"
                                               FontSize="16"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"/>

                                    <TextBlock FontSize="16" Margin="0,6,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="Количество: {0} ({1})">
                                                <Binding Path="StockLabel"/>
                                                <Binding Path="Quantity"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Цена, ₽" FontSize="16" TextAlignment="Right"/>
                                    <TextBlock Text="{Binding OriginalPrice, StringFormat={}{0:N2}}"
                                               TextDecorations="Strikethrough"
                                               Foreground="#575757"
                                               FontSize="16"
                                               TextAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N2}}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"/>

                                    <Button Content="Подробнее"
                                            Margin="0,8,0,0"
                                            Padding="10,3"
                                            FontSize="16"
                                            Click="ProductDetails_Click"
                                            Visibility="{Binding CanOpenProduct, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ProductDetailsVisibility}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="AddProductButton" Content="Добавить товар"
                    Padding="16,4"
                    Margin="0,0,10,0"
                    Visibility="Collapsed"
                    Click="AddProduct_Click"/>
            <Button x:Name="OrdersButton" Content="Заказы"
                    Padding="16,4"
                    Visibility="Collapsed"
                    Click="Orders_Click"/>
        </StackPanel>

        <Button Name="LogOut" Content="Выйти"
                Grid.Row="2"
                HorizontalAlignment="Left"
                Margin="0,12,0,0"
                Padding="16,4"
                Click="LogOut_Click"/>
    </Grid>
</Window>
