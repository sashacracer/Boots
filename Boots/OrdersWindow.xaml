<Window x:Class="Boots.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказы"
        Style="{StaticResource Windows}"
        Width="760" Height="500"
        MinWidth="500" MinHeight="350"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="EmptyOrdersText"
                   Text="Заказов пока нет."
                   Visibility="Collapsed"
                   Margin="0,0,0,12"/>

        <DataGrid x:Name="OrdersGrid"
                  Grid.Row="1"
                  SelectionMode="Single"
                  SelectedValuePath="OrderId"
                  SelectionChanged="OrdersGrid_SelectionChanged"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  FontFamily="Times New Roman"
                  FontSize="16">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy}}" Width="135"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding CustomerName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Состав заказа" FontWeight="SemiBold" Margin="0,0,0,6"/>

            <DataGrid x:Name="OrderItemsGrid"
                      Grid.Row="1"
                      SelectionMode="Single"
                      SelectedValuePath="OrderItemId"
                      SelectionChanged="OrderItemsGrid_SelectionChanged"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      FontFamily="Times New Roman"
                      FontSize="16">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Модель" Binding="{Binding ProductName}" Width="2*"/>
                    <DataGridTextColumn Header="Производитель" Binding="{Binding ManufacturerName}" Width="*"/>
                    <DataGridTextColumn Header="Размер" Binding="{Binding SizeValue}" Width="70"/>
                    <DataGridTextColumn Header="Пар" Binding="{Binding Quantity}" Width="55"/>
                    <DataGridTextColumn Header="Цена за пару, ₽" Binding="{Binding UnitPrice, StringFormat=N2}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="OrderTotalText"
                       Grid.Row="2"
                       Text="Выбери заказ в верхней таблице."
                       FontWeight="SemiBold"
                       Margin="0,8,0,0"/>

            <WrapPanel x:Name="OrderEditPanel" Grid.Row="3" Margin="0,12,0,0"
                       Visibility="Collapsed" IsEnabled="False">
                <DatePicker x:Name="OrderDatePicker"
                            Language="ru-RU" Width="130"
                            Margin="0,0,8,6"
                            AutomationProperties.Name="Дата заказа"/>
                <Button Content="Сохранить дату"
                        Margin="0,0,12,6" Padding="12,4"
                        Click="SaveDate_Click"/>
                <Button x:Name="DeleteOrderItemButton"
                        Content="Удалить позицию"
                        Margin="0,0,0,6" Padding="12,4"
                        IsEnabled="False"
                        Click="DeleteOrderItem_Click"/>
            </WrapPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="DeleteOrderButton"
                    Content="Удалить заказ"
                    Margin="0,0,10,0"
                    Padding="16,4"
                    Visibility="Collapsed"
                    IsEnabled="False"
                    Click="DeleteOrder_Click"/>
            <Button x:Name="AddOrderButton"
                    Content="Добавить заказ"
                    Padding="16,4"
                    Visibility="Collapsed"
                    Click="AddOrder_Click"/>
        </StackPanel>

        <Button Grid.Row="3"
                Content="Назад"
                IsCancel="True"
                HorizontalAlignment="Left"
                Margin="0,12,0,0"
                Padding="16,4"/>
    </Grid>
</Window>
