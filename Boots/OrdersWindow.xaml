<Window x:Class="Boots.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказы"
        Style="{StaticResource Windows}"
        Width="760" Height="500"
        MinWidth="500" MinHeight="350"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="EmptyOrdersText"
                   Text="Заказов пока нет."
                   Visibility="Collapsed"
                   Margin="0,0,0,12"/>

        <DataGrid x:Name="OrdersGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  FontFamily="Times New Roman"
                  FontSize="16">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy}}" Width="135"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding CustomerName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2"
                Content="Назад"
                IsCancel="True"
                HorizontalAlignment="Left"
                Margin="0,12,0,0"
                Padding="16,4"/>
    </Grid>
</Window>
