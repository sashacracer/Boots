<Window x:Class="Boots.OrderCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый заказ"
        Style="{StaticResource Windows}"
        Width="840" Height="510"
        MinWidth="650" MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Label Content="Клиент"
                   Target="{Binding ElementName=CustomerBox}"
                   FontFamily="Times New Roman"
                   FontSize="20"
                   Margin="0,0,8,0"/>
            <ComboBox x:Name="CustomerBox"
                      Width="300"
                      DisplayMemberPath="FullName"
                      SelectedValuePath="UserId"/>
            <Button Content="Добавить товар"
                    Margin="12,0,0,0"
                    Padding="12,4"
                    Click="AddProduct_Click"/>
        </StackPanel>

        <DataGrid x:Name="DraftGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  FontFamily="Times New Roman"
                  FontSize="16">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Модель" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding SizeValue}" Width="75"/>
                <DataGridTextColumn Header="Пар" Binding="{Binding Quantity}" Width="60"/>
                <DataGridTextColumn Header="Цена за пару, ₽" Binding="{Binding UnitPrice, StringFormat=N2}" Width="130"/>
                <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding LineTotal, StringFormat=N2}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="Убрать позицию"
                    Padding="12,4" Click="RemoveProduct_Click"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Подтвердить заказ"
                        Padding="12,4"
                        Margin="0,0,10,0"
                        Click="ConfirmOrder_Click"/>
                <Button Content="Отмена" Padding="12,4" IsCancel="True"/>
            </StackPanel>
            <TextBlock x:Name="DraftTotal" Text="Итого: 0,00 ₽" Margin="12,0" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
